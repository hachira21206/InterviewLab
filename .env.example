# ==============================================================================
# Environment Configuration Template (Development)
# Copy this file to .env for local development
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=false
PROJECT_NAME="Backend Intern Interview Platform"
API_V1_STR=/api/v1

# Frontend Origins (CORS) - Comma-separated or JSON array
FRONTEND_ORIGINS=http://localhost:3000

# PostgreSQL Database Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=interview_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Optional: Computed or explicit Database URL
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_db

# Storage Configuration
STORAGE_ROOT=data/uploads/cv
MAX_UPLOAD_SIZE_BYTES=5242880

# AI Provider Settings (groq / gemini / fake for tests only)
AI_PROVIDER=fake
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
# For Gemini Free tier, set AI_PROVIDER=gemini and supply a key from Google AI Studio.
# Do not commit the real key. Gemini still applies rate limits.
GEMINI_API_KEY=AIza_your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_REQUEST_TIMEOUT_SECONDS=30

# Character Limits & Budgeting
AI_MAX_CV_CHARS=8000
AI_MAX_JD_CHARS=4000
AI_MAX_TOTAL_CHARS=12000
AI_MAX_INTERVIEW_INPUT_CHARS=20000
AI_MAX_EVALUATION_QUESTIONS_CHARS=5000
AI_MAX_EVALUATION_ANSWERS_CHARS=20000
AI_MAX_EVALUATION_KEY_POINTS_CHARS=6000
AI_MAX_EVALUATION_TOTAL_PROMPT_CHARS=35000

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
