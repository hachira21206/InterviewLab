# ==============================================================================
# Production Environment Configuration Template
# Use this template for production-like deployment with Docker Compose
# DO NOT commit real secrets or production credentials to source control!
# ==============================================================================

# Application Environment (strict checks enforced)
APP_ENV=production
DEBUG=false
PROJECT_NAME="Backend Intern Interview Platform"
API_V1_STR=/api/v1

# Frontend Origins (CORS) - MUST be explicitly set, NO wildcard '*' permitted
FRONTEND_ORIGINS=http://localhost:3000

# PostgreSQL Database (internal to Docker network in production)
POSTGRES_USER=postgres_prod_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=interview_prod_db

# Ports published to host
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Storage Root inside container
STORAGE_ROOT=/app/data/uploads/cv
MAX_UPLOAD_SIZE_BYTES=5242880

# AI Provider Settings
# Choose exactly one external provider: groq or gemini.
# For Gemini Free tier, set AI_PROVIDER=gemini and leave GROQ_API_KEY blank.
AI_PROVIDER=gemini
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=AIza_your_real_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_REQUEST_TIMEOUT_SECONDS=30

# Character Limits & Budgeting
AI_MAX_CV_CHARS=8000
AI_MAX_JD_CHARS=4000
AI_MAX_TOTAL_CHARS=12000
AI_MAX_INTERVIEW_INPUT_CHARS=20000
AI_MAX_EVALUATION_QUESTIONS_CHARS=5000
AI_MAX_EVALUATION_ANSWERS_CHARS=20000
AI_MAX_EVALUATION_KEY_POINTS_CHARS=6000
AI_MAX_EVALUATION_TOTAL_PROMPT_CHARS=35000

# Frontend Build & Runtime
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
